<!DOCTYPE html>
<html lang="{{LANG}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{NAME}} — CV</title>
<style>
  @font-face {
    font-family: 'Space Grotesk';
    src: url('./fonts/space-grotesk-latin.woff2') format('woff2');
    font-weight: 300 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'DM Sans';
    src: url('./fonts/dm-sans-latin.woff2') format('woff2');
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    font-size: 10px;
    line-height: 1.4;
    color: #1a1a2e;
    background: #ffffff;
    padding: 0;
    margin: 0;
  }

  .page {
    width: 210mm;
    height: 297mm;
    margin: 0 auto;
    padding: 12mm 15mm;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* === HEADER === */
  .header {
    margin-bottom: 12px;
    border-bottom: 2px solid #f0f0f5;
    padding-bottom: 10px;
  }

  .header h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 26px;
    font-weight: 700;
    color: #1a1a2e;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 4px;
    text-transform: uppercase;
  }

  .header-subtitle {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: hsl(270, 70%, 45%);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* === LAYOUT === */
  .cv-grid {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 20px;
    flex: 1;
  }

  /* === SECTIONS === */
  .section {
    margin-bottom: 12px;
  }

  .section-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: hsl(187, 74%, 32%);
    border-bottom: 1px solid #eef2f3;
    padding-bottom: 3px;
    margin-bottom: 8px;
  }

  /* === MAIN COLUMN === */
  .summary-text {
    font-size: 10px;
    line-height: 1.5;
    color: #333;
    margin-bottom: 4px;
  }

  .job {
    margin-bottom: 10px;
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2px;
  }

  .job-company {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11.5px;
    font-weight: 700;
    color: #1a1a2e;
  }

  .job-period {
    font-size: 9px;
    color: #666;
    font-weight: 500;
  }

  .job-role {
    font-size: 10px;
    font-weight: 600;
    color: hsl(270, 70%, 45%);
    margin-bottom: 3px;
  }

  .job-subtitle {
    font-size: 9.5px;
    color: #555;
    font-style: italic;
    margin-bottom: 4px;
  }

  .job ul {
    padding-left: 14px;
  }

  .job li {
    font-size: 9.5px;
    line-height: 1.4;
    color: #444;
    margin-bottom: 2px;
  }

  .job li strong {
    color: #222;
  }

  .project {
    margin-bottom: 8px;
  }

  .project-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 2px;
  }

  .project-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 10.5px;
    font-weight: 700;
    color: #1a1a2e;
  }

  .project-badge {
    font-size: 8px;
    font-weight: 600;
    color: white;
    background: hsl(187, 74%, 32%);
    padding: 1px 5px;
    border-radius: 3px;
    text-transform: uppercase;
  }

  .project-desc {
    font-size: 9.5px;
    color: #444;
  }

  .project-tech {
    font-size: 8.5px;
    color: #777;
    margin-top: 1px;
    font-style: italic;
  }

  /* === SIDEBAR === */
  .sidebar {
    background: #fcfcfd;
    padding: 0 12px;
    border-left: 1px solid #f0f0f5;
  }

  .contact-info {
    margin-bottom: 15px;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 5px;
    font-size: 9.5px;
    color: #444;
  }

  .contact-item a {
    color: #444;
    text-decoration: none;
  }

  .competencies-list {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .competency-item {
    font-size: 9.5px;
    color: #333;
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }

  .competency-item::before {
    content: "•";
    color: hsl(187, 74%, 32%);
    font-weight: bold;
  }

  .sidebar-section {
    margin-bottom: 15px;
  }

  .sidebar-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #1a1a2e;
    margin-bottom: 6px;
    border-bottom: 1px solid #eef2f3;
    padding-bottom: 2px;
  }

  .edu-item, .cert-item {
    margin-bottom: 6px;
  }

  .edu-title, .cert-title {
    font-size: 9.5px;
    font-weight: 700;
    color: #222;
  }

  .edu-org, .cert-org {
    font-size: 9px;
    color: hsl(270, 70%, 45%);
    font-weight: 500;
  }

  .edu-year, .cert-year {
    font-size: 8.5px;
    color: #888;
  }

  .skills-group {
    margin-bottom: 8px;
  }

  .skills-label {
    font-weight: 700;
    font-size: 9px;
    color: #555;
    display: block;
    margin-bottom: 2px;
  }

  .skills-values {
    font-size: 9px;
    color: #444;
    line-height: 1.3;
  }

  /* === PRINT === */
  @media print {
    .page {
      margin: 0;
      padding: 10mm;
      width: 210mm;
      height: 297mm;
    }
  }
</style>
</head>
<body>
<div class="page">

  <!-- HEADER -->
  <header class="header">
    <h1>{{NAME}}</h1>
    <div class="header-subtitle">{{HEADLINE}}</div>
  </header>

  <div class="cv-grid">
    <!-- MAIN COLUMN -->
    <main class="main-content">
      
      <!-- PROFESSIONAL SUMMARY -->
      <section class="section">
        <h2 class="section-title">{{SECTION_SUMMARY}}</h2>
        <div class="summary-text">{{SUMMARY_TEXT}}</div>
      </section>

      <!-- WORK EXPERIENCE -->
      <section class="section">
        <h2 class="section-title">{{SECTION_EXPERIENCE}}</h2>
        {{EXPERIENCE}}
      </section>

      <!-- PROJECTS -->
      <section class="section">
        <h2 class="section-title">{{SECTION_PROJECTS}}</h2>
        {{PROJECTS}}
      </section>

    </main>

    <!-- SIDEBAR -->
    <aside class="sidebar">
      
      <!-- CONTACT -->
      <div class="sidebar-section">
        <h3 class="sidebar-title">Contact</h3>
        <div class="contact-info">
          <div class="contact-item"><span>📍</span> {{LOCATION}}</div>
          <div class="contact-item"><span>✉️</span> {{EMAIL}}</div>
          <div class="contact-item"><span>📞</span> {{PHONE}}</div>
          <div class="contact-item"><span>🔗</span> <a href="{{LINKEDIN_URL}}">{{LINKEDIN_DISPLAY}}</a></div>
        </div>
      </div>

      <!-- CORE COMPETENCIES -->
      <div class="sidebar-section">
        <h3 class="sidebar-title">{{SECTION_COMPETENCIES}}</h3>
        <div class="competencies-list">
          {{COMPETENCIES_SIDEBAR}}
        </div>
      </div>

      <!-- SKILLS / STACK -->
      <div class="sidebar-section">
        <h3 class="sidebar-title">{{SECTION_SKILLS}}</h3>
        {{SKILLS_SIDEBAR}}
      </div>

      <!-- EDUCATION -->
      <div class="sidebar-section">
        <h3 class="sidebar-title">{{SECTION_EDUCATION}}</h3>
        {{EDUCATION}}
      </div>

      <!-- CERTIFICATIONS -->
      <div class="sidebar-section">
        <h3 class="sidebar-title">{{SECTION_CERTIFICATIONS}}</h3>
        {{CERTIFICATIONS}}
      </div>

    </aside>
  </div>

</div>
</body>
</html>
